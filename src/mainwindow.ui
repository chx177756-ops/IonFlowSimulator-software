  </widget>

  <widget class="QDockWidget" name="dockSettings">
   <property name="windowTitle"><string>设置</string></property>
   <attribute name="dockWidgetArea"><number>1</number></attribute>
   <widget class="QWidget" name="dockWidgetContents_2">
    <layout class="QVBoxLayout" name="verticalLayout_3">
     <property name="margin"><number>4</number></property>
     <item>
      <widget class="QStackedWidget" name="stackedWidgetSettings">
       <property name="currentIndex"><number>0</number></property>
       
       <widget class="QWidget" name="pageGroup">
        <layout class="QVBoxLayout" name="verticalLayout_page1">
         <item>
          <layout class="QFormLayout" name="formLayout">
           <item row="0" column="0"><widget class="QLabel" name="label"><property name="text"><string>标签:</string></property></widget></item>
           <item row="0" column="1"><widget class="QLineEdit" name="editGroupName"><property name="enabled"><bool>false</bool></property></widget></item>
          </layout>
         </item>
         <item>
          <widget class="QGroupBox" name="groupBox">
           <property name="title"><string>输入实体 (边界)</string></property>
           <layout class="QVBoxLayout" name="verticalLayout_4">
            <item><widget class="QPushButton" name="btnClear"><property name="text"><string>清空选择</string></property></widget></item>
            <item><widget class="QListWidget" name="listSelectedFaces"/></item>
           </layout>
          </widget>
         </item>
         <item><spacer name="verticalSpacer"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
        </layout>
       </widget>
       
       <widget class="QWidget" name="pageMesh">
        <layout class="QVBoxLayout" name="verticalLayout_page2">
         <item>
          <widget class="QGroupBox" name="groupMeshTarget">
           <property name="title"><string>目标物理组</string></property>
           <layout class="QVBoxLayout">
            <item><widget class="QComboBox" name="comboMeshGroupTarget"/></item>
            <item><widget class="QCheckBox" name="chkEnableLocalField"><property name="text"><string>启用该区域的局部网格加密场</string></property></widget></item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="groupBoxMesh">
           <property name="title"><string>局部场控制参数 (Local Field)</string></property>
           <layout class="QFormLayout" name="formLayout_2">
            <item row="0" column="0"><widget class="QLabel"><property name="text"><string>SizeMin (最小网格):</string></property></widget></item>
            <item row="0" column="1"><widget class="QDoubleSpinBox" name="spinSizeMin"><property name="decimals"><number>3</number></property><property name="maximum"><double>10000.0</double></property></widget></item>
            <item row="1" column="0"><widget class="QLabel"><property name="text"><string>SizeMax (最大网格):</string></property></widget></item>
            <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinSizeMax"><property name="decimals"><number>3</number></property><property name="maximum"><double>10000.0</double></property></widget></item>
            <item row="2" column="0"><widget class="QLabel"><property name="text"><string>DistMin (加密起点):</string></property></widget></item>
            <item row="2" column="1"><widget class="QDoubleSpinBox" name="spinDistMin"><property name="decimals"><number>3</number></property><property name="maximum"><double>10000.0</double></property></widget></item>
            <item row="3" column="0"><widget class="QLabel"><property name="text"><string>DistMax (加密范围):</string></property></widget></item>
            <item row="3" column="1"><widget class="QDoubleSpinBox" name="spinDistMax"><property name="decimals"><number>3</number></property><property name="maximum"><double>10000.0</double></property></widget></item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="groupGlobalMesh">
           <property name="title"><string>全局设置</string></property>
           <layout class="QFormLayout">
            <item row="0" column="0"><widget class="QLabel"><property name="text"><string>网格阶次 (Order):</string></property></widget></item>
            <item row="0" column="1">
             <widget class="QComboBox" name="comboOrder">
              <item><property name="text"><string>1阶 (线性直边)</string></property></item>
              <item><property name="text"><string>2阶 (二阶曲面贴合)</string></property></item>
             </widget>
            </item>
            <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Netgen 优化:</string></property></widget></item>
            <item row="1" column="1"><widget class="QCheckBox" name="checkOptimize"><property name="text"><string>启用</string></property><property name="checked"><bool>true</bool></property></widget></item>
            <item row="2" column="0"><widget class="QLabel"><property name="text"><string>并行线程数:</string></property></widget></item>
            <item row="2" column="1"><widget class="QSpinBox" name="spinMeshThreads"><property name="minimum"><number>1</number></property><property name="maximum"><number>128</number></property></widget></item>
           </layout>
          </widget>
         </item>

         <item><widget class="QPushButton" name="btnGenerateMesh"><property name="minimumSize"><size><width>0</width><height>40</height></size></property><property name="text"><string>按照当前方案生成网格</string></property></widget></item>
         <item><widget class="QPushButton" name="btnExportMesh"><property name="minimumSize"><size><width>0</width><height>30</height></size></property><property name="text"><string>导出当前网格至 .msh 文件</string></property></widget></item>
         <item><spacer name="verticalSpacer_2"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
        </layout>
